# CODEOWNERS — automatically requests reviews from the listed owners
# when a PR touches the matching paths.
#
# On the GitHub Free plan, CODEOWNERS are not enforced for branch protection
# unless the repo also has branch protection rules. They DO, however, work
# as PR-review request signals regardless of plan.

# Default owners for everything in the repo.
*                           @sakurablush

# Workflow and CI/CD — be careful, breaks deploys.
/.github/                   @sakurablush

# Security-sensitive: secrets, key handling, security docs.
SECURITY.md                 @sakurablush

# Core WebGL / shader code — review required for rendering changes.
/src/engine/renderer/       @sakurablush
/src/utils/                 @sakurablush

# UI / HUD components
/src/ui/                    @sakurablush

# State management
/src/state/                 @sakurablush

# Tests
/src/__tests__/             @sakurablush

# Documentation
/docs/                      @sakurablush
README.md                   @sakurablush
